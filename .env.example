# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://deploylite:deploylite@localhost:5432/deploylite"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# GitHub webhook secret (set this same value in the GitHub repo webhook settings)
GITHUB_WEBHOOK_SECRET="changeme"

# API server
PORT=4000

# Base host for generated deployment URLs, e.g. http://localhost -> http://localhost:PORT
DEPLOYMENT_HOST="http://localhost"
